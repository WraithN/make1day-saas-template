# ─────────────────────────────────────────────────────────────
# make1day — Waffo Pancake 上线 env 模板（只含这条链路需要的变量）
#
#   cp .env.waffo-pancake.example .env.local
#   # 逐项替换所有 REPLACE_ME_*，然后：
#   node scripts/waffo-preflight.mjs --strict
#
# 字段来源与联调顺序见 docs/waffo-launch-checklist.md
# 协议细节见 docs/waffo.md。**本模板只适用于 docs.waffo.ai 的 Pancake。**
# ─────────────────────────────────────────────────────────────

# ── 站点公开地址（结账 successUrl / canonical / sitemap / llms.txt 都依赖它）──
NEXT_PUBLIC_SITE_URL=https://REPLACE_ME_DOMAIN

# ── Supabase（必需；0001_init.sql + 0003_licenses.sql 都要执行）──
NEXT_PUBLIC_SUPABASE_URL=https://REPLACE_ME_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=REPLACE_ME_ANON_KEY
# 仅服务端，绝不放到 NEXT_PUBLIC_*
SUPABASE_SERVICE_ROLE_KEY=REPLACE_ME_SERVICE_ROLE_KEY
NEXT_PUBLIC_OAUTH_PROVIDERS=google,github

# ── 支付商 ──────────────────────────────────────────────────
PAYMENT_PROVIDER=waffo
WAFFO_FLAVOR=pancake
# test | prod；切换时必须同时换产品 ID 与对应环境的验签公钥
WAFFO_ENVIRONMENT=test

# 鉴权二选一，官方明确互斥。A. Store Slug（推荐，最省事）：
WAFFO_STORE_SLUG=REPLACE_ME_STORE_SLUG
# B. RSA API-Key：删掉上面 WAFFO_STORE_SLUG 一行，再启用下面两行。
# WAFFO_MERCHANT_ID=REPLACE_ME_MERCHANT_ID
# WAFFO_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_ME_PRIVATE_KEY\n-----END PRIVATE KEY-----"
# WAFFO_STORE_ID=                      # 可选，通常由 productId 推断

# 端点保持默认，不要改成旧版假想地址
WAFFO_API_BASE=https://api.waffo.ai
WAFFO_CHECKOUT_PATH=/v1/actions/checkout/create-session

# Pancake 里「产品 ID」就是「价格 ID」（Dashboard → Products）
WAFFO_PRICE_ID_BUYOUT=REPLACE_ME_ONETIME_PRODUCT_ID
WAFFO_PRICE_ID_CARE=REPLACE_ME_SUBSCRIPTION_PRODUCT_ID

# 平台级 Webhook Public Key，test / prod 各一套，两套都必须填。
# 单行 env 中用 \n 表示 PEM 换行；lib/env.ts 会自动还原。
WAFFO_WEBHOOK_PUBLIC_KEY_TEST="-----BEGIN PUBLIC KEY-----\nREPLACE_ME_TEST_PUBLIC_KEY\n-----END PUBLIC KEY-----"
WAFFO_WEBHOOK_PUBLIC_KEY_PROD="-----BEGIN PUBLIC KEY-----\nREPLACE_ME_PROD_PUBLIC_KEY\n-----END PUBLIC KEY-----"

# 唯一 webhook 地址（在所有支付商之间共用）：
#   https://<REPLACE_ME_DOMAIN>/api/webhook
# 不要设置：WAFFO_WEBHOOK_SECRET（旧 HMAC 假设）、WAFFO_API_KEY（Pancake 不用 Bearer）、
#           WAFFO_WEBHOOK_PUBLIC_KEY（那是 Acquiring 的单公钥变量）。
# 本模板只适用于 Pancake；Acquiring 与 Lemon Squeezy 的变量分别见
# docs/waffo.md 第 5 节（WAFFO_ACQUIRING_*）与 .env.example（LEMONSQUEEZY_*）。

# ── 下载授权（保护本站 POST /api/generate）─────────────────
# 生成：openssl rand -hex 32
LICENSE_SECRET=REPLACE_ME_RANDOM_HEX_64
# auto = 生产且配了 secret 才开；生成的客户模板已强制 LICENSE_GATE=off
LICENSE_GATE=auto
# 每 IP 每日匿名试用下载数；0 = 硬付费墙
FREE_GENERATIONS_PER_DAY=1

# ── 管理后台（未设置时 /admin 与 /admin/licenses 是公开的）──
ADMIN_USER=REPLACE_ME_ADMIN_USER
ADMIN_PASSWORD=REPLACE_ME_ADMIN_PASSWORD
# 可选：逗号分隔的管理员邮箱白名单；设置后且 Supabase 已配置时，
# /admin 除 Basic Auth 外还要求登录用户邮箱在此列表中。
# ADMIN_EMAILS=you@example.com,ops@example.com

# ── 可选 ────────────────────────────────────────────────────
# NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_BOOKING_URL=
NEXT_PUBLIC_CONTACT_EMAIL=hello@make1day.com
AI_PROVIDER=openai
# OPENAI_API_KEY=
# EMBEDDING_API_KEY=
RAG_VECTOR_STORE=memory
