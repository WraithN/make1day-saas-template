# ─────────────────────────────────────────────────────────────
# ShipKit environment variables
# Copy this file to `.env.local` and fill in real values.
# Build works with NONE of these set (clients are created lazily on first use).
# ─────────────────────────────────────────────────────────────

# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Service role key — SERVER ONLY, never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Auth / OAuth ─────────────────────────────────────────────
NEXT_PUBLIC_OAUTH_PROVIDERS=google,github,apple,microsoft

# ── Payment provider selection ───────────────────────────────
# One of: waffo | stripe | creem | paypal | lemonsqueezy. ShipKit's own
# checkout uses Waffo.
PAYMENT_PROVIDER=waffo

# ── Waffo (ACTIVE gateway) ───────────────────────────────────
# ⚠️ "Waffo" is TWO incompatible products. Pick the one you signed up for:
#   pancake   → docs.waffo.ai   MoR / digital products / solo founders (DEFAULT)
#   acquiring → waffo.com/docs  SE-Asia acquiring gateway
WAFFO_FLAVOR=pancake

# ── Pancake ──────────────────────────────────────────────────
WAFFO_ENVIRONMENT=test                    # test | prod
WAFFO_STORE_SLUG=your-store-slug         # public checkout auth
# Alternative: signed server-to-server auth (X-Merchant-Id + X-Signature).
# WAFFO_MERCHANT_ID=MER_xxx
# WAFFO_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# WAFFO_STORE_ID=STO_xxx                 # optional; inferred from productId
WAFFO_API_BASE=https://api.waffo.ai
WAFFO_CHECKOUT_PATH=/v1/actions/checkout/create-session
# In Pancake the price id IS the product id (Dashboard → Products).
WAFFO_PRICE_ID_BUYOUT=PROD_xxx           # ONE-TIME product
WAFFO_PRICE_ID_CARE=PROD_xxx             # MONTHLY subscription product
# Webhook public keys: Dashboard → Settings → Webhooks. They are platform-level
# (one test key, one prod key, shared by all stores). BOTH are required.
WAFFO_WEBHOOK_PUBLIC_KEY_TEST="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
WAFFO_WEBHOOK_PUBLIC_KEY_PROD="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
# Legacy price slots (fallbacks only): WAFFO_PRICE_ID_PRO / WAFFO_PRICE_ID_SCALE

# ── Acquiring (only when WAFFO_FLAVOR=acquiring) ─────────────
# createCheckoutAcquiring() IS implemented. EVERY merchant-contract field
# comes from env below — ShipKit never invents one. Copy the values from your
# Waffo contract (waffo.com/docs). All protocol details are 需按你的 Waffo
# 合同核对 — see docs/waffo.md §5.
# WAFFO_API_BASE=https://waffo.com
# WAFFO_CHECKOUT_PATH=/api/v1/order/create
# WAFFO_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"      # RSA request signing
# WAFFO_WEBHOOK_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----" # webhook verify
# WAFFO_ACQUIRING_MERCHANT_INFO={"merchantId":"...","...":"..."}  # JSON string, per contract
# WAFFO_ACQUIRING_USER_INFO={"...":"..."}                         # JSON string, per contract
# WAFFO_ACQUIRING_PAYMENT_INFO={"...":"..."}                      # JSON string, per contract
# WAFFO_ACQUIRING_ORDER_CURRENCY=USD
# WAFFO_ACQUIRING_ORDER_DESCRIPTION=ShipKit license
# WAFFO_ACQUIRING_SIGN_MODE=pancake    # pancake | raw — MUST match your contract
# Runtime-generated (no env needed): merchantOrderId, paymentRequestId,
#   orderRequestedAt, notifyUrl (NEXT_PUBLIC_SITE_URL + /api/webhook).
# GET /api/payments/self-check lists any still-missing WAFFO_ACQUIRING_* vars.

# Webhook URL for EVERY provider (single route): https://<domain>/api/webhook
# Config self-check (no secrets returned): GET /api/payments/self-check

# Stripe — Buyout is ONE-TIME, Care is MONTHLY.
# STRIPE_SECRET_KEY=sk_test_xxx
# STRIPE_WEBHOOK_SECRET=whsec_xxx
# STRIPE_PRICE_ID_BUYOUT=price_xxx
# STRIPE_PRICE_ID_CARE=price_xxx
# STRIPE_PRICE_ID_PRO=price_xxx
# STRIPE_PRICE_ID_SCALE=price_xxx

# Creem (Stripe-like hosted checkout + webhooks)
# CREEM_API_KEY=creem_xxx
# CREEM_WEBHOOK_SECRET=whsec_xxx
# CREEM_ENV=test                      # test | live
# CREEM_PRICE_ID_PRO=prod_xxx
# CREEM_PRICE_ID_SCALE=prod_xxx

# PayPal (adapter creates subscription checkouts; use Waffo/Stripe for one-time)
# PAYPAL_CLIENT_ID=xxx
# PAYPAL_CLIENT_SECRET=xxx
# PAYPAL_WEBHOOK_ID=WH-xxx
# PAYPAL_ENV=sandbox                 # sandbox | live
# PAYPAL_PLAN_ID_PRO=P-xxx
# PAYPAL_PLAN_ID_SCALE=P-xxx

# ── Lemon Squeezy (JSON:API checkout + HMAC webhook) ─────────
# LEMONSQUEEZY_API_KEY=xxx
# LEMONSQUEEZY_WEBHOOK_SECRET=xxx           # HMAC-SHA256 of raw body (x-signature)
# LEMONSQUEEZY_STORE_ID=12345               # relationships.store.data.id
# LEMONSQUEEZY_VARIANT_ID_BUYOUT=12345      # one-time Buyout variant
# LEMONSQUEEZY_VARIANT_ID_CARE=12345        # recurring Care variant
# LEMONSQUEEZY_API_BASE=https://api.lemonsqueezy.com/v1
# Webhook URL (same single route): https://<domain>/api/webhook

# ── License gate (protects POST /api/generate) ───────────────
# HMAC secret used to sign offline license keys. Generate: openssl rand -hex 32
# REQUIRED in production: without it no license can be issued, so nobody can
# unlock a download. The gate itself does NOT depend on this value.
LICENSE_SECRET=
# on | off | auto (default).
#   auto → ON in production, OFF in development. Fail-safe: a production
#          deployment ALWAYS gates, even when LICENSE_SECRET is missing.
#   off  → local experiments only. Never set it on a public deployment.
# Generated customer projects ship with the gate OFF — their lib/env.ts
# defaults to LICENSE_GATE=off.
LICENSE_GATE=auto
# Free PREVIEW downloads per visitor per UTC day. A preview holds the file
# inventory of the configured build plus the design tokens — never source
# code. 0 = no anonymous previews at all.
FREE_GENERATIONS_PER_DAY=1
# Free previews per network (IP) per UTC day: the coarse brake for visitors
# who clear their cookies. Defaults to 20x the per-visitor limit.
# FREE_GENERATIONS_PER_DAY_PER_IP=20
# Issue a key manually: LICENSE_SECRET=... node scripts/issue-license.mjs \
#   --email buyer@example.com --plan buyout --order ORD_123

# ── AI providers ─────────────────────────────────────────────
AI_PROVIDER=openai

# AI chat quota: how many AI messages ONE user may send per UTC day.
# The counter is keyed by the user id and resets at 00:00 UTC.
# 0 = the AI feature is switched off entirely (every request answers 429).
# The counter lives in Supabase (supabase/migrations/0009_ai_usage.sql) when
# SUPABASE_SERVICE_ROLE_KEY is set, otherwise in the local .data/shipkit.db.
AI_MESSAGES_PER_DAY=50

OPENAI_API_KEY=sk-xxx
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

OPENROUTER_API_KEY=sk-or-xxx
OPENROUTER_MODEL=openai/gpt-4o-mini

DEEPSEEK_API_KEY=sk-xxx
DEEPSEEK_MODEL=deepseek-chat

GROQ_API_KEY=gsk_xxx
GROQ_MODEL=llama-3.3-70b-versatile

ANTHROPIC_API_KEY=sk-ant-xxx
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

GEMINI_API_KEY=xxx
GEMINI_MODEL=gemini-1.5-flash

# ── RAG hybrid retrieval (BM25 + embeddings, RRF fusion) ─────
# Falls back to OPENAI_API_KEY. With no key, RAG degrades to BM25-only.
# EMBEDDING_API_KEY=sk-xxx
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIMENSIONS=1536
# memory (default) | supabase — supabase persists vectors via 0002_rag.sql
RAG_VECTOR_STORE=memory

# ── Site ─────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Transactional email (verification / password reset / tickets) ─
# See docs/email.md. The code only SENDS; deliverability depends on your DNS
# (SPF / DKIM / DMARC / a dedicated sending subdomain) — that is provider-side
# work, not application code.
# Providers: resend (REST, zero deps) | webhook (custom HTTP mailer) | none
# smtp is a RESERVED, NOT-IMPLEMENTED value: this repo has no nodemailer
# dependency. Install nodemailer + @types/nodemailer and add a dynamic-import
# adapter yourself before claiming SMTP support (docs/email.md §0).
MAIL_PROVIDER=none
# RESEND_API_KEY=re_xxx                 # required for MAIL_PROVIDER=resend
# MAIL_FROM=no-reply@mail.example.com  # must be a VERIFIED sending domain
# MAIL_FROM_NAME=ShipKit
# MAIL_REPLY_TO=support@example.com
# MAIL_WEBHOOK_URL=https://mailer.example.com/send   # required for webhook
# MAIL_WEBHOOK_TOKEN=                 # optional bearer token for the webhook
# MAIL_OPERATOR_EMAIL=ops@example.com  # new-ticket notices; defaults to NEXT_PUBLIC_CONTACT_EMAIL
# MAIL_TOKEN_TTL_HOURS=24            # reset / verification link lifetime
# Readiness (no secrets returned): GET /api/mail/self-check

# ── Custom 1:1 service (pricing page CTA) ─────────────────────
NEXT_PUBLIC_BOOKING_URL=
NEXT_PUBLIC_CONTACT_EMAIL=hello@shipkit.dev

# ── Analytics / admin (set a password in production!) ─────────
# NEXT_PUBLIC_GA_ID=G-XXXXXXX
#
# The /admin console is locked behind an in-page operator sign-in (NOT HTTP
# Basic Auth, which embedded previews and non-Chrome clients cannot show).
# These two variables seed the operator account on first use: the username is
# stored as-is, the password only as a scrypt hash in the local database.
# Open http://localhost:3000/admin and sign in with them.
ADMIN_USER=admin
ADMIN_PASSWORD=change-me
# Without these, /admin renders a "no operator account configured" notice in
# development and returns 503 in production.
#
# Optional second way in: when Supabase is configured, a signed-in user with
# an admin/staff role (or an email in this allowlist) may open the console too.
# ADMIN_EMAILS=you@example.com,ops@example.com
#
# ── Local database ───────────────────────────────────────────
# Licenses, orders, pageviews, traffic events, operator accounts and sessions
# live in a local SQLite database (Node's built-in `node:sqlite`, no native
# dependency). The file is created on first use; point SQLITE_PATH somewhere
# else to relocate it.
# SQLITE_PATH=.data/shipkit.db
# A previous install's .data/*.json files are imported automatically once.
#
# The USER DIRECTORY and ROLES live here too: without SUPABASE_SERVICE_ROLE_KEY
# the admin console reads and writes accounts + roles in this database, so the
# role column really works on a local install. Set SUPABASE_SERVICE_ROLE_KEY
# above to move them to Supabase Auth + the `profiles` table — no code change.
# Migrate the local roles first: npm run export:profiles
#
# Production deployments should configure Supabase (service-role key above):
# a file on an ephemeral serverless filesystem is not durable. Apply the
# migrations in supabase/migrations/ — 0008_traffic_funnel.sql adds the
# table behind the /admin/stats conversion funnel.

# ── Demo / mock login ───────────────────────────────────────
# Once Supabase is configured, demo mode is FORCIBLY OFF.
NEXT_PUBLIC_ENABLE_DEMO=false
