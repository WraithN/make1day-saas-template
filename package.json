{
  "name": "make1day",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.5.0"
  },
  "description": "make1day — configurable AI SaaS starter and source generator. Auth, subscriptions, a real AI feature, an admin console, and white-label ZIP delivery.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "waffo:preflight": "node scripts/waffo-preflight.mjs",
    "probe:webhook": "node scripts/payment-webhook-probe.mjs",
    "verify:matrix": "node scripts/verify-matrix.mjs --all",
    "smoke": "npm run smoke:gate && npm run smoke:ai:quota && npm run smoke:ai:quota:supabase && npm run smoke:ai:stream",
    "smoke:gate": "node scripts/smoke-license-gate.cjs",
    "smoke:ai:quota": "node scripts/smoke-ai-quota.cjs",
    "smoke:ai:quota:supabase": "node scripts/smoke-ai-quota-supabase.cjs",
    "smoke:ai:stream": "node scripts/smoke-ai-stream.cjs",
    "export:profiles": "node scripts/export-local-profiles.mjs",
    "rag:bench": "node scripts/rag-bench.mjs",
    "rebrand": "node scripts/rebrand.mjs",
    "agents:lint": "node scripts/agents-lint.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "@google/generative-ai": "^0.21.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.47.10",
    "jszip": "^3.10.2",
    "next": "^15.1.0",
    "openai": "^4.73.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "stripe": "^17.2.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2"
  }
}
