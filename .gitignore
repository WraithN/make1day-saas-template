# dependencies
/node_modules
/.pnp
.pnp.js

# next.js
/.next/
/.next-*/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env
.env*.local

# typescript
*.tsbuildinfo
next-env.d.ts

# runtime analytics data (first-party pageview counter)
/.data/

# build-matrix CI snapshot (regenerated by `npm run verify:matrix --build --publish`)
/public/build-matrix.json

# local matrix extraction artifacts (old runs are moved aside, not deleted,
# because the WorkBuddy safe-delete shim blocks large recursive removals)
/.matrix-out/
/.matrix-out-*/
